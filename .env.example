# =============================================================================
# TutorIA — configuración del backend. Copia este archivo a .env y ajusta valores.
# Valores por defecto seguros para desarrollo: todo proveedor externo es "fake".
# NUNCA subas un .env con secretos reales al repositorio.
# =============================================================================

# --- General y base de datos -------------------------------------------------
# development | test | production (en production se rechazan proveedores fake/local)
APP_ENV=development
# PostgreSQL con psycopg 3. En desarrollo sin Docker puedes usar sqlite:///./tutoria_dev.db
DATABASE_URL=postgresql+psycopg://tutoria:tutoria@localhost:5432/tutoria
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# require si la base es un servicio administrado (p. ej. RDS); en la red interna de Docker basta prefer
DB_SSLMODE=prefer

# --- Sesión ------------------------------------------------------------------
# Mínimo 32 caracteres en producción. Genera uno con: python -m app.scripts.generar_clave_local
JWT_SECRET=solo-desarrollo-cambiar-este-secreto-jwt-0000
JWT_EXPIRA_MINUTOS=1440
COOKIE_NOMBRE=tutoria_sesion
# Vacío (recomendado): frontend y API comparten origen tras el proxy (/api/), cookie de un solo host.
# Solo si se separan en subdominios: dominio padre válido (p. ej. .tutoria.co).
COOKIE_DOMAIN=
# true fuera de desarrollo (en production se fuerza Secure)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Lista JSON de orígenes exactos del frontend (sin comodines)
CORS_ORIGINS=["http://localhost:4200"]
FRONTEND_URL=http://localhost:4200
RATE_LIMIT_LOGIN_INTENTOS=5
RATE_LIMIT_LOGIN_VENTANA_MINUTOS=15

# --- Edad y autorización del acudiente --------------------------------------
EDAD_MINIMA=13
EDAD_MAYORIA=18
EDAD_MAXIMA=100
# Vigencia del enlace de confirmación enviado al acudiente
AUTORIZACION_TOKEN_HORAS=72
# Días que una autorización confirmada se considera vigente
AUTORIZACION_EXPIRA_DIAS=365
AUTORIZACION_MAX_SOLICITUDES_POR_HORA=3

# --- Correo (fake | smtp | ses) ----------------------------------------------
CORREO_PROVEEDOR=fake
CORREO_REMITENTE=no-responder@tutoria.local
SES_REGION=us-east-1
SMTP_HOST=localhost
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_TLS=true

# --- Cifrado de columnas (local | kms) --------------------------------------
# local SOLO para desarrollo. En producción: kms + CIFRADO_DEK_ENVUELTA (python -m app.scripts.generar_dek_kms)
CIFRADO_PROVEEDOR=local
# Clave AES-256 en base64 (32 bytes). La de abajo es de ejemplo: genera una propia.
CIFRADO_CLAVE_LOCAL=ZGVzYXJyb2xsby1zb2xvLWNsYXZlLWFlcy0zMmJ5dGU=
CIFRADO_VERSION_ACTUAL=v1
# Claves/DEK anteriores para rotación, JSON {"v1": "..."} (ver app/scripts/rotar_cifrado.py)
CIFRADO_CLAVES_ANTERIORES={}
CIFRADO_DEK_ENVUELTA=
KMS_KEY_ID=
KMS_REGION=us-east-1
# Clave HMAC del índice ciego (correo) y de seudónimos (IP, safety_identifier). Mínimo 32 caracteres.
INDICE_CIEGO_CLAVE=solo-desarrollo-cambiar-clave-indice-ciego-0000

# --- Almacén de archivos (local | s3) ----------------------------------------
ALMACEN_PROVEEDOR=local
ALMACEN_RUTA_LOCAL=./almacen_local
# Bucket privado con SSE-KMS
S3_BUCKET=
S3_REGION=us-east-1

# --- Archivos del estudiante (solo nivel AVANZADO) ---------------------------
ARCHIVO_MAX_BYTES=5242880
ARCHIVO_MIMES_PERMITIDOS=["text/plain","application/pdf","image/png","image/jpeg","image/webp"]
ARCHIVO_RETENCION_DIAS=180
ARCHIVO_SUBIDO_HORAS=24
ARCHIVO_MAX_POR_ACTIVIDAD=1
ARCHIVO_TEXTO_MAX_CARACTERES=20000
ARCHIVO_IMAGEN_LADO_MAX=2000

# --- Claude (fake | anthropic) -----------------------------------------------
# Llave de la consola de Anthropic con cuenta comercial de API. Solo vive en el backend.
LLM_PROVIDER=fake
LLM_API_KEY=
# Identificadores vigentes al escribir esto (verifícalos con python -m app.scripts.probar_llm):
#   sencillo (por defecto): claude-haiku-5-5   ·   complejo: claude-sonnet-5-5
LLM_MODEL_SENCILLO=claude-haiku-5-5
LLM_MODEL_COMPLEJO=claude-sonnet-5-5
LLM_TIMEOUT_SEGUNDOS=45
LLM_REINTENTOS_RED=2
LLM_MAX_TOKENS_CUESTIONARIO=6000
LLM_MAX_TOKENS_PLAN=8000
LLM_MAX_TOKENS_TUTOR=8000
LLM_MAX_TOKENS_CONSOLIDACION=4000
# Puntaje desde el que se usa el modelo complejo (§11.2)
COMPLEJIDAD_UMBRAL=3
SELECTOR_PALABRAS_LARGO=60

# --- OpenAI: moderación (gratuita) e ilustraciones de último recurso ---------
OPENAI_API_KEY=
MODERACION_PROVEEDOR=fake
MODERACION_MODELO=omni-moderation-latest
# Umbrales por categoría; recalibrar cuando OpenAI actualice el modelo
MODERACION_UMBRALES={"self-harm":0.3,"sexual":0.5,"sexual/minors":0.1,"violence":0.6,"violence/graphic":0.4,"harassment":0.6,"hate":0.5,"illicit":0.5}
IMAGENES_IA_ACTIVA=false
IMAGENES_IA_PROVEEDOR=fake
# Verifica el identificador y si tu organización requiere verificación en la consola de OpenAI.
IMAGENES_IA_MODELO=gpt-image-2.5-flare
IMAGENES_IA_TAMANO=1024x1024
# webp | jpeg | png. La calidad NO es configurable: siempre "low" (constante del código).
IMAGENES_IA_FORMATO=webp
IMAGENES_IA_MAX_INTENTOS=1
# Se usa solo si la API no informa el uso (se marca es_estimacion=true)
IMAGENES_IA_COSTO_ESTIMADO_USD=0.02
PRESUPUESTO_IMAGENES_MENSUAL_USD=5.0

# --- Costos (USD por millón de tokens). Verifica en las páginas de precios. --
# Valores de la documentación de Anthropic al 2026-10 (Haiku 5.5 con prompts de hasta 100K tokens).
TARIFAS_IA={"claude-haiku-5-5":{"entrada":0.10,"salida":0.50,"cache_lectura":0.01,"cache_escritura":0.125},"claude-sonnet-5-5":{"entrada":2.0,"salida":10.0,"cache_lectura":0.20,"cache_escritura":2.5}}

# --- Fuentes de texto verificables (§12.2) -----------------------------------
FUENTES_OBLIGATORIAS=true
FUENTES_MAX_POR_TURNO=5
FUENTES_CACHE_DIAS=30
# Lista JSON de dominios permitidos globalmente; vacía = los de cada proveedor
FUENTES_DOMINIOS_PERMITIDOS=[]
# Dominios bloqueados adicionales (lista JSON). Se SUMAN a la lista base del código
# (app/fuentes/bloqueo.py: sitios que cualquiera puede editar); nunca la reducen.
FUENTES_DOMINIOS_BLOQUEADOS=[]
# La prensa confiable (PRENSA_CONFIABLE) no cumple sola la autoridad mínima; true solo para actualidad.
PRENSA_RESPALDA_SOLA=false
# Proveedores por categoría (ver docs/fuentes.md). Adaptadores: openalex | medlineplus | ckan | fake.
# La app no arranca si un proveedor de texto apunta a un dominio bloqueado. Autoridad: 2 a 4.
# Para desarrollo sin red usa los "fake" (valor por defecto si no defines esta variable).
FUENTES_PROVEEDORES=[{"id":"openalex","categoria":"ACADEMICA_ABIERTA","adaptador":"openalex","activo":true,"idiomas":["es","en"],"base_url":"https://api.openalex.org/works"},{"id":"medlineplus_es","categoria":"INSTITUCIONAL_OFICIAL","adaptador":"medlineplus","activo":true,"idiomas":["es","en"],"base_url":"https://wsearch.nlm.nih.gov/ws/query","parametros":{"tool":"tutoria"}},{"id":"portal_ckan","categoria":"INSTITUCIONAL_OFICIAL","adaptador":"ckan","activo":false,"base_url":"https://REEMPLAZAR-PORTAL-CKAN/api/3/action/package_search","parametros":{"sitio":"Portal de datos abiertos","url_dataset":"https://REEMPLAZAR-PORTAL-CKAN/dataset/"}}]
FUENTES_TIMEOUT_SEGUNDOS=8
FUENTES_IDIOMAS=["es","en"]
# Exigido por los proveedores públicos: nombre del servicio y un contacto real
FUENTES_USER_AGENT=TutorIA/0.1 (contacto: datos@tu-dominio.co)
FUENTES_EXTRACTO_MAX_CARACTERES=1500
FUENTES_EXTRACTO_HERRAMIENTA=600
AUTORIDAD_MINIMA_BASICO=2
AUTORIDAD_MINIMA_INTERMEDIO=3
AUTORIDAD_MINIMA_AVANZADO=3
FUENTES_WEB_SEARCH_ACTIVA=false
FUENTES_DOMINIOS_WEB_PERMITIDOS=[]

# --- Imágenes con licencia abierta (§12.3) -----------------------------------
# Adaptadores: mediawiki_commons | iiif_museo | fake. "dominios" = desde dónde se permite descargar.
IMAGENES_PROVEEDORES=[{"id":"wikimedia_commons","categoria":"REPOSITORIO_COLABORATIVO","adaptador":"mediawiki_commons","activo":true,"base_url":"https://commons.wikimedia.org/w/api.php","dominios":["upload.wikimedia.org","thumb.wikimedia.org"]},{"id":"art_institute_chicago","categoria":"PATRIMONIO_ABIERTO","adaptador":"iiif_museo","activo":false,"base_url":"https://api.artic.edu/api/v1/artworks/search","dominios":["www.artic.edu"]}]
IMAGENES_USER_AGENT=TutorIA/0.1 (contacto: datos@tu-dominio.co)
# PD (dominio público), CC0, CC-BY, CC-BY-SA. NC y ND se excluyen siempre.
IMAGENES_LICENCIAS_PERMITIDAS=["PD","CC0","CC-BY","CC-BY-SA"]
IMAGENES_TIMEOUT_SEGUNDOS=10
IMAGENES_MAX_BYTES=8000000
IMAGENES_LADO_MAXIMO=1200
IMAGENES_ANCHO_MINIMO=400
IMAGENES_MAX_REDIRECCIONES=3
IMAGENES_MODERAR_EXTERNAS=true
IMAGENES_CACHE_DIAS=90
TRABAJO_VISUAL_TIMEOUT_SEGUNDOS=120

# --- Videos (fake | youtube) --------------------------------------------------
VIDEOS_PROVEEDOR=fake
VIDEOS_BUSQUEDA_DINAMICA=false
YOUTUBE_API_KEY=
# Lista JSON de id de canal confiables para la búsqueda dinámica
VIDEOS_CANALES_CONFIABLES=[]
VIDEO_DURACION_MIN_SEGUNDOS=240
VIDEO_DURACION_MAX_SEGUNDOS=1200
VIDEO_METADATOS_MAX_DIAS=30
VIDEOS_MAX_RESULTADOS=3

# --- Diagnóstico y plan -------------------------------------------------------
DIAGNOSTICO_PREGUNTAS=5
DIAGNOSTICO_PREGUNTAS_MIN=3
DIAGNOSTICO_PREGUNTAS_MAX=5
UMBRAL_BASICO=0.4
UMBRAL_INTERMEDIO=0.75
PLAN_MAX_REINTENTOS=2

# --- Chat -----------------------------------------------------------------------
TUTOR_NOMBRE=Vex
CHAT_VENTANA_MENSAJES=30
CHAT_MAX_ITERACIONES_HERRAMIENTAS=4
CHAT_MAX_BUSQUEDAS_FUENTES=2
CHAT_MAX_REINTENTOS=1
# Menor que el timeout del proxy (Nginx/ALB) para responder un error controlado
CHAT_TIMEOUT_TURNO_SEGUNDOS=100
CHAT_INACTIVIDAD_MINUTOS=30
CONSOLIDACION_MAX_CARACTERES=12000
PERFIL_ALPHA=0.2
PERFIL_OBSERVACIONES_CONFIANZA=10
PERFIL_EXPLORACION_CADA=4

# --- Planes y límites diarios -------------------------------------------------
LIMITE_MENSAJES_GRATIS=20
LIMITE_MENSAJES_PREMIUM=200
LIMITE_PLANES_GRATIS=5
LIMITE_PLANES_PREMIUM=50
LIMITE_IMAGENES_IA_GRATIS=2
LIMITE_IMAGENES_IA_PREMIUM=10
LIMITE_BUSQUEDAS_VIDEO_GRATIS=5
LIMITE_BUSQUEDAS_VIDEO_PREMIUM=30
LIMITE_ARCHIVOS_GRATIS=3
LIMITE_ARCHIVOS_PREMIUM=20
# Conversaciones abiertas a la vez en el plan gratuito
LIMITE_TEMAS_GRATIS=1
# Planes visibles en el historial del plan gratuito
HISTORIAL_ITEMS_GRATIS=5
PREMIUM_PRECIO_ANUAL_COP=130000
# Solo existe la pasarela simulada; en producción se debe agregar un adaptador real
PASARELA_PROVEEDOR=fake
PASARELA_SECRETO_WEBHOOK=solo-desarrollo-secreto-webhook-000000

# --- Seguridad infantil y retención -------------------------------------------
# Solo líneas verificadas con la fuente oficial
LINEAS_AYUDA=[{"nombre":"Línea 141 del ICBF","numero":"141"},{"nombre":"Línea de emergencias","numero":"123"}]
RETENCION_ALERTAS_DIAS=365
RETENCION_MENSAJES_DIAS=365
RETENCION_CONSUMO_DIAS=730

# --- Protección de datos (Ley 1581). Obligatorios en producción. --------------
RESPONSABLE_RAZON_SOCIAL=
RESPONSABLE_NIT=
RESPONSABLE_DOMICILIO=
RESPONSABLE_CORREO_DATOS=
POLITICA_VERSION=1
POLITICA_VERSION_MINIMA_ACEPTADA=1
PRIVACIDAD_PLAZO_CONSULTA_DIAS_HABILES=10
PRIVACIDAD_PLAZO_RECLAMO_DIAS_HABILES=15
# Festivos de Colombia como lista JSON de fechas ISO; actualízala cada año con la fuente oficial
FESTIVOS_CO=[]
